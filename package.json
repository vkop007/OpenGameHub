{
  "name": "opengamehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Universal open-source browser game platform where one game = one folder inside /games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkop007/OpenGameHub.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm games:build && pnpm --filter @opengamehub/web dev",
    "build": "pnpm games:build && pnpm --filter @opengamehub/web build",
    "start": "pnpm --filter @opengamehub/web start",
    "lint": "node scripts/lint.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-tests.ts",
    "test:e2e": "node scripts/browser-e2e.ts",
    "games:scan": "node scripts/games-cli.ts scan",
    "games:validate": "node scripts/games-cli.ts validate",
    "games:build": "node scripts/games-cli.ts build",
    "games:test": "node scripts/games-cli.ts test",
    "game:validate": "node scripts/games-cli.ts validate-one",
    "game:build": "node scripts/games-cli.ts build-one"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
